# EmailJS credentials — copy to .env and fill in from https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Public site URL (canonical is always https://www.ethosprogram.com)
VITE_SITE_URL=https://www.ethosprogram.com
